<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: cyan tactical glowing border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/navy_primary" />
            <stroke
                android:width="2dp"
                android:color="@color/radar_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Default state: deep navy background with crisp border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/navy_primary" />
            <stroke
                android:width="1.5dp"
                android:color="@color/navy_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
